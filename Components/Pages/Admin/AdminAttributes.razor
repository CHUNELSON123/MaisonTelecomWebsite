@page "/admin/attributes"
@layout MaisonTelecom.Components.Layout.AdminLayout
@using MaisonTelecom.Services
@inject ProductService ProductService
@rendermode InteractiveServer

<div class="admin-page-container">
    <h1 class="admin-page-title">Manage Product Attributes</h1>

    <div class="admin-content-box">

        @* --- TABS --- *@
        <div class="attr-tabs">
            @foreach (var type in AttributeTypes)
            {
                <button class="@(SelectedType == type ? "active" : "")"
                        @onclick="() => SelectType(type)">
                    @type
                </button>
            }
        </div>

        <div class="attr-body">
            <h3>Manage @SelectedType</h3>

            @* --- ADD NEW FORM --- *@
            <div class="add-form">
                <input type="text" @bind="NewValue" placeholder="Enter new @SelectedType..." />
                <button class="btn-add" @onclick="AddValue">+ Add</button>
            </div>

            @* --- LIST --- *@
            <div class="value-list">
                @if (CurrentValues == null)
                {
                    <p>Loading...</p>
                }
                else if (!CurrentValues.Any())
                {
                    <p class="text-muted">No items found for @SelectedType.</p>
                }
                else
                {
                    @foreach (var val in CurrentValues)
                    {
                        <div class="value-item @(EditingItem == val ? "editing-mode" : "")">
                            @if (EditingItem == val)
                            {
                                @* EDIT MODE *@
                                <input @bind="TempEditValue" class="form-control" style="flex:1; margin-right:10px;" />
                                <div class="actions">
                                    <button class="btn-save" @onclick="SaveEdit" title="Save"><i class="fas fa-check"></i></button>
                                    <button class="btn-cancel" @onclick="CancelEdit" title="Cancel"><i class="fas fa-times"></i></button>
                                </div>
                            }
                            else
                            {
                                @* READ MODE *@
                                <span>@val</span>
                                <div class="actions">
                                    <button class="btn-edit" @onclick="() => StartEdit(val)" title="Edit"><i class="fas fa-pen"></i></button>
                                    <button class="btn-delete" @onclick="() => DeleteValue(val)" title="Delete">×</button>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .attr-tabs {
        display: flex;
        gap: 10px;
        border-bottom: 2px solid #eee;
        padding-bottom: 10px;
        margin-bottom: 20px;
        overflow-x: auto;
    }

        .attr-tabs button {
            border: none;
            background: #f8f9fa;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            color: #555;
            white-space: nowrap;
            transition: all 0.2s;
        }

            .attr-tabs button.active {
                background: #007bff;
                color: white;
            }

    .add-form {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

        .add-form input {
            flex: 1;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

    .btn-add {
        background: #28a745;
        color: white;
        border: none;
        padding: 0 20px;
        border-radius: 5px;
        cursor: pointer;
        font-weight: bold;
    }

    .value-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 15px;
    }

    .value-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        border: 1px solid #eee;
        padding: 10px 15px;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        height: 50px; /* Keep height consistent */
    }

        .value-item.editing-mode {
            border: 1px solid #007bff;
            background: #f0f8ff;
        }

    .actions {
        display: flex;
        gap: 5px;
    }

    /* Button Styles */
    .btn-delete, .btn-edit, .btn-save, .btn-cancel {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.9em;
        transition: transform 0.1s;
    }

        .btn-delete:hover, .btn-edit:hover, .btn-save:hover, .btn-cancel:hover {
            transform: scale(1.1);
        }

    .btn-delete {
        background: #fee;
        color: #dc3545;
    }

    .btn-edit {
        background: #eef;
        color: #007bff;
    }

    .btn-save {
        background: #efe;
        color: #28a745;
    }

    .btn-cancel {
        background: #eee;
        color: #666;
    }

</style>

@code {
    private string SelectedType = "Brand"; // Changed default to Brand as it's more common
    private string NewValue = "";
    private List<string> CurrentValues = new();

    // Editing State
    private string? EditingItem = null; // Which item are we editing?
    private string TempEditValue = "";  // What is the new text?

    private List<string> AttributeTypes = new()
    {
        "Category", "Brand", "RAM", "ROM", "Processor", "Display"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadValues();
    }

    private async Task SelectType(string type)
    {
        SelectedType = type;
        CancelEdit(); // Stop editing if switching tabs
        await LoadValues();
    }

    private async Task LoadValues()
    {
        CurrentValues = await ProductService.GetAttributeValuesAsync(SelectedType);
    }

    private async Task AddValue()
    {
        if (!string.IsNullOrWhiteSpace(NewValue))
        {
            await ProductService.AddAttributeAsync(SelectedType, NewValue);
            NewValue = "";
            await LoadValues();
        }
    }

    private async Task DeleteValue(string val)
    {
        bool confirm = true; // In a real app, you might want a JS confirm dialog here
        if (confirm)
        {
            await ProductService.DeleteAttributeAsync(SelectedType, val);
            await LoadValues();
        }
    }

    // --- EDIT FUNCTIONS ---

    private void StartEdit(string val)
    {
        EditingItem = val;
        TempEditValue = val;
    }

    private void CancelEdit()
    {
        EditingItem = null;
        TempEditValue = "";
    }

    private async Task SaveEdit()
    {
        if (!string.IsNullOrWhiteSpace(TempEditValue) && EditingItem != null)
        {
            // Call the new service method
            await ProductService.UpdateAttributeAsync(SelectedType, EditingItem, TempEditValue);

            EditingItem = null;
            await LoadValues();
        }
    }
}