@page "/admin/reviews"
@using MaisonTelecom.Models
@using MaisonTelecom.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject IJSRuntime JSRuntime
@layout MaisonTelecom.Components.Layout.AdminLayout
@rendermode InteractiveServer

<div class="admin-page-container">
    <div class="admin-header">
        <h1>Customer Reviews</h1>
    </div>

    <div class="admin-content-box">
        @if (Reviews.Count == 0)
        {
            <p style="text-align:center; padding:20px; color:#666;">No reviews submitted yet.</p>
        }
        else
        {
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reviewer</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Reviews)
                    {
                        <tr>
                            <td>@review.DatePosted.ToShortDateString()</td>
                            <td><strong>@review.ReviewerName</strong></td>
                            <td style="color:#f1c40f;">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <span>★</span>
                                }
                            </td>
                            <td>@review.Content</td>
                            <td>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteReview(review)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .admin-header {
        margin-bottom: 20px;
    }

    .admin-table th, .admin-table td {
        padding: 12px;
        border-bottom: 1px solid #eee;
        text-align: left;
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }
</style>

@code {
    private List<Review> Reviews = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadReviews();
    }

    private async Task LoadReviews()
    {
        Reviews = await DbContext.Reviews.OrderByDescending(r => r.DatePosted).ToListAsync();
    }

    private async Task DeleteReview(Review review)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this review?");
        if (confirmed)
        {
            DbContext.Reviews.Remove(review);
            await DbContext.SaveChangesAsync();
            await LoadReviews(); // Refresh list
        }
    }
}