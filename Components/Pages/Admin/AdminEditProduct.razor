            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .gallery-thumb button {
            position: absolute;
            top: 0;
            right: 0;
            background: rgba(220, 53, 69, 0.9);
            color: white;
            border: none;
            width: 20px;
            height: 20px;
            font-size: 14px;
            line-height: 18px;
            cursor: pointer;
