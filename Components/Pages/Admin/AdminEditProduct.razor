    .half-width {
        flex: 1;
    }

    .three-col {
        gap: 15px;
    }

        .three-col .form-group {
            flex: 1;
        }

    .image-upload-container {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
