@page "/admin/products/add"
@rendermode InteractiveServer
@layout MaisonTelecom.Components.Layout.AdminLayout
@using MaisonTelecom.ViewModels
@using MaisonTelecom.Data
@using MaisonTelecom.Models
@using MaisonTelecom.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject ApplicationDbContext dbContext
@inject ProductService ProductService
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment

<div class="admin-page-container">
    <div class="admin-header">
        <h1 class="admin-page-title">Add New Product</h1>
        <button class="back-button" @onclick="Cancel"><i class="fas fa-arrow-left"></i> Back</button>
    </div>

    <div class="admin-content-box">
        <div class="admin-form-container">
            <EditForm Model="@ViewModel" OnValidSubmit="@HandleAddProduct">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <h3 class="section-title">General Information</h3>
                <div class="form-group">
                    <label>Product Name</label>
                    <InputText @bind-Value="ViewModel.Name" class="form-control" placeholder="e.g. iPhone 15 Pro Max" />
                </div>

                <div class="form-row">
                    <div class="form-group half-width">
                        <label>Brand</label>
                        <InputSelect @bind-Value="ViewModel.Brand" class="form-control">
                            <option value="">Select Brand</option>
                            @foreach (var b in ViewModel.BrandOptions)
                            {
                                <option value="@b">@b</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group half-width">
                        <label>Category</label>
                        <InputSelect @bind-Value="ViewModel.ProductCategory" class="form-control">
                            <option value="">Select Category</option>
                            @foreach (var c in ViewModel.CategoryOptions)
                            {
                                <option value="@c">@c</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <h3 class="section-title">Pricing & Inventory</h3>
                <div class="form-row three-col">
                    <div class="form-group">
                        <label>Price (FCFA)</label>
                        <InputNumber @bind-Value="ViewModel.Price" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Promo Price (Optional)</label>
                        <InputNumber @bind-Value="ViewModel.PromoPrice" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Stock Quantity</label>
                        <InputNumber @bind-Value="ViewModel.StockQuantity" class="form-control" />
                    </div>
                </div>

                <h3 class="section-title">Technical Specifications</h3>
                <div class="form-row">
                    <div class="form-group half-width">
                        <label>RAM</label>
                        <InputSelect @bind-Value="ViewModel.RAM" class="form-control">
                            <option value="">Select RAM</option>
                            @foreach (var r in ViewModel.RAMOptions)
                            {
                                <option value="@r">@r</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group half-width">
                        <label>ROM (Storage)</label>
                        <InputSelect @bind-Value="ViewModel.ROM" class="form-control">
                            <option value="">Select Storage</option>
                            @foreach (var r in ViewModel.ROMOptions)
                            {
                                <option value="@r">@r</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group half-width">
                        <label>Processor</label>
                        <InputSelect @bind-Value="ViewModel.Processor" class="form-control">
                            <option value="">Select Processor</option>
                            @foreach (var p in ViewModel.ProcessorOptions)
                            {
                                <option value="@p">@p</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group half-width">
                        <label>Display Size</label>
                        <InputSelect @bind-Value="ViewModel.Display" class="form-control">
                            <option value="">Select Display</option>
                            @foreach (var d in ViewModel.DisplayOptions)
                            {
                                <option value="@d">@d</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <h3 class="section-title">Product Details</h3>
                <div class="form-group">
                    <label>Basic Specs (Short Description)</label>
                    <InputTextArea @bind-Value="ViewModel.BasicSpecs" class="form-control" rows="3" />
                </div>

                <div class="form-group">
                    <label>Display Properties (Details)</label>
                    <InputTextArea @bind-Value="ViewModel.DisplayProperties" class="form-control" rows="2" />
                </div>

                <div class="form-group">
                    <label>Special Features</label>
                    <InputTextArea @bind-Value="ViewModel.SpecialFeatures" class="form-control" rows="2" />
                </div>

                <div class="image-upload-container">
                    <h3 class="section-title" style="margin-top:0;">Product Images</h3>

                    <div class="form-group">
                        <label>Main Image</label>
                        <div class="upload-row">
                            <InputText class="form-control" @bind-Value="ViewModel.ImageURL1" placeholder="Image URL..." readonly />
                            <label class="btn btn-secondary upload-btn">
                                @(isUploadingMain ? "Wait..." : "Upload")
                                <InputFile OnChange="LoadMainImage" hidden accept=".jpg,.jpeg,.png,.webp" />
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Gallery Images</label>
                        <div class="upload-row">
                            <label class="btn btn-outline-primary upload-btn full-width">
                                <i class="fas fa-images"></i> Add Gallery Photos
                                <InputFile OnChange="LoadGalleryImages" multiple hidden accept=".jpg,.jpeg,.png,.webp" />
                            </label>
                            @if (isUploadingGallery)
                            {
                                <span class="upload-status">Uploading...</span>
                            }
                        </div>
                        <div class="gallery-preview-text">
                            <strong>Uploaded:</strong>
                            @if (!string.IsNullOrEmpty(ViewModel.ImageURL2))
                            {
                                <span>Image 2 <i class="fas fa-check"></i></span>
                            }
                            @if (!string.IsNullOrEmpty(ViewModel.ImageURL3))
                            {
                                <span>Image 3 <i class="fas fa-check"></i></span>
                            }
                            @if (!string.IsNullOrEmpty(ViewModel.ImageURL4))
                            {
                                <span>Image 4 <i class="fas fa-check"></i></span>
                            }
                            @if (!string.IsNullOrEmpty(ViewModel.ImageURL5))
                            {
                                <span>Image 5 <i class="fas fa-check"></i></span>
                            }
                        </div>
                    </div>
                </div>

                <div class="checkbox-row">
                    <label class="checkbox-label">
                        <InputCheckbox @bind-Value="ViewModel.IsTrending" />
                        Is Trending
                    </label>
                    <label class="checkbox-label">
                        <InputCheckbox @bind-Value="ViewModel.IsLatest" />
                        Is Latest
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="saved-button" disabled="@(isUploadingMain || isUploadingGallery)">
                        <i class="fas fa-save"></i> Save Product
                    </button>
                    <button type="button" @onclick="Cancel" class="cancel-button">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@* --- INLINE STYLES FOR LAYOUT --- *@
<style>
    /* Spacing and Layout */
    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #444;
        margin-top: 25px;
        margin-bottom: 15px;
        border-bottom: 2px solid #eee;
        padding-bottom: 5px;
    }

    .form-row {
        display: flex;
        gap: 20px;
        margin-bottom: 15px;
    }

    .half-width {
        flex: 1;
    }

    .three-col {
        gap: 15px;
    }

        .three-col .form-group {
            flex: 1;
        }

    /* Image Upload Section Styling */
    .image-upload-container {
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 20px;
        margin: 25px 0;
    }

    .upload-row {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .upload-btn {
        cursor: pointer;
        white-space: nowrap;
    }

        .upload-btn.full-width {
            width: 100%;
            text-align: center;
            padding: 10px;
        }

    .gallery-preview-text {
        margin-top: 10px;
        font-size: 0.85rem;
        color: #666;
    }

        .gallery-preview-text span {
            display: inline-block;
            background: #e3f2fd;
            color: #0d47a1;
            padding: 2px 8px;
            border-radius: 10px;
            margin-right: 5px;
        }

    /* Checkboxes */
    .checkbox-row {
        display: flex;
        gap: 30px;
        margin-bottom: 30px;
        background: #fff;
        padding: 15px;
        border: 1px solid #eee;
        border-radius: 6px;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        cursor: pointer;
    }

    /* Header Buttons */
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .back-button {
        background: none;
        border: 1px solid #ccc;
        padding: 5px 15px;
        border-radius: 4px;
        cursor: pointer;
    }
</style>

@code {
    private AdminAddProductViewModel ViewModel { get; set; } = new AdminAddProductViewModel();
    private bool isUploadingMain = false;
    private bool isUploadingGallery = false;
    private const long MaxFileSize = 1024 * 1024 * 5; // 5MB

    protected override async Task OnInitializedAsync()
    {
        // Load dropdowns from DB
        ViewModel.BrandOptions = await ProductService.GetAttributeValuesAsync("Brand");
        ViewModel.CategoryOptions = await ProductService.GetAttributeValuesAsync("Category");
        ViewModel.RAMOptions = await ProductService.GetAttributeValuesAsync("RAM");
        ViewModel.ROMOptions = await ProductService.GetAttributeValuesAsync("ROM");
        ViewModel.ProcessorOptions = await ProductService.GetAttributeValuesAsync("Processor");
        ViewModel.DisplayOptions = await ProductService.GetAttributeValuesAsync("Display");
    }

    private async Task HandleAddProduct()
    {
        var newProduct = ViewModel.ToProduct();
        dbContext.Products.Add(newProduct);
        await dbContext.SaveChangesAsync();
        NavigationManager.NavigateTo("/admin/products");
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/products");
    }

    private async Task LoadMainImage(InputFileChangeEventArgs e)
    {
        isUploadingMain = true;
        try
        {
            var url = await UploadFileAsync(e.File);
            ViewModel.ImageURL1 = url;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading main image: {ex.Message}");
        }
        finally
        {
            isUploadingMain = false;
        }
    }

    private async Task LoadGalleryImages(InputFileChangeEventArgs e)
    {
        isUploadingGallery = true;
        try
        {
            var files = e.GetMultipleFiles(4);
            foreach (var file in files)
            {
                var url = await UploadFileAsync(file);

                // Logic to find first empty slot
                if (string.IsNullOrEmpty(ViewModel.ImageURL2)) ViewModel.ImageURL2 = url;
                else if (string.IsNullOrEmpty(ViewModel.ImageURL3)) ViewModel.ImageURL3 = url;
                else if (string.IsNullOrEmpty(ViewModel.ImageURL4)) ViewModel.ImageURL4 = url;
                else if (string.IsNullOrEmpty(ViewModel.ImageURL5)) ViewModel.ImageURL5 = url;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading gallery images: {ex.Message}");
        }
        finally
        {
            isUploadingGallery = false;
        }
    }

    private async Task<string> UploadFileAsync(IBrowserFile file)
    {
        var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
        var path = Path.Combine(Environment.WebRootPath, "Image", "products", fileName);
        Directory.CreateDirectory(Path.GetDirectoryName(path));
        await using var stream = new FileStream(path, FileMode.Create);
        await file.OpenReadStream(MaxFileSize).CopyToAsync(stream);
        return $"/Image/products/{fileName}";
    }
}