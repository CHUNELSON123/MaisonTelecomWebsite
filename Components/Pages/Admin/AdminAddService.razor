@page "/admin/services/add"
@using MaisonTelecom.Models
@using MaisonTelecom.Data
@using Microsoft.EntityFrameworkCore
@using System.IO
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@layout MaisonTelecom.Components.Layout.AdminLayout
@rendermode InteractiveServer

<div class="admin-page-container">
    <h1 class="admin-page-title">Add New Service</h1>

    <div class="admin-content-box">
        <div class="admin-content-header">
            <h2>Service Details</h2>
            <a href="/admin/services" class="back-button">Back to List</a>
        </div>

        <div class="admin-form-container">
            <EditForm Model="@NewService" OnValidSubmit="@HandleAddService">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @* 1. Service Name *@
                <div class="form-group">
                    <label>Service Name:</label>
                    <InputText @bind-Value="NewService.Name" class="form-control" placeholder="e.g. Network Decoding" />
                </div>

                @* 2. Description *@
                <div class="form-group">
                    <label>Short Description:</label>
                    <InputTextArea @bind-Value="NewService.BasicSpecs" class="form-control" rows="2" placeholder="Brief explanation of the service..." />
                </div>

                @* 3. Features *@
                <div class="form-group">
                    <label>Key Features (One per line or comma separated):</label>
                    <InputTextArea @bind-Value="NewService.SpecialFeatures" class="form-control" rows="4" placeholder="Instant Unlock&#10;No Data Loss&#10;Safe Method" />
                </div>

                @* 4. ICON SECTION (Upload OR Font Code) *@
                <div style="background: #f8f9fa; padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #dee2e6;">
                    <h4 style="font-size: 1rem; margin-bottom: 15px; color: #0d6efd;">Service Icon</h4>

                    @* Option A: Upload Image *@
                    <div class="form-group">
                        <label>Option A: Upload Custom Icon/Image</label>
                        <InputFile OnChange="HandleIconUpload" class="form-control" accept=".png,.jpg,.jpeg,.svg" />
                        @if (!string.IsNullOrEmpty(NewService.ImageURL1))
                        {
                            <div class="mt-2">
                                <span class="text-success"><i class="fas fa-check"></i> Image Uploaded</span>
                                <img src="@NewService.ImageURL1" style="height: 40px; margin-left: 10px; border-radius: 4px; border: 1px solid #ccc;" />
                            </div>
                        }
                    </div>

                    <div style="text-align: center; margin: 10px 0; font-weight: bold; color: #666;">--- OR ---</div>

                    @* Option B: FontAwesome Class *@
                    <div class="form-group">
                        <label>Option B: FontAwesome Class (e.g., fas fa-wrench)</label>
                        <div style="display: flex; gap: 10px; align-items: center;">
                            <InputText @bind-Value="NewService.IconClass" class="form-control" placeholder="fas fa-wrench" />
                            <div style="font-size: 1.5rem; width: 40px; text-align: center; color: #007bff;">
                                <i class="@(NewService.IconClass ?? "fas fa-wrench")"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="saved-button">Save Service</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

<style>
    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .saved-button {
        background-color: #28a745;
        color: white;
        padding: 10px 20px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        width: 100%;
    }

        .saved-button:hover {
            background-color: #218838;
        }

    .back-button {
        text-decoration: none;
        color: #555;
        border: 1px solid #ccc;
        padding: 5px 10px;
        border-radius: 4px;
    }
</style>

@code {
    private Product NewService { get; set; } = new Product();

    protected override void OnInitialized()
    {
        // Defaults
        NewService.Type = ProductType.Service;
        NewService.ProductCategory = "Software";
        NewService.Price = 0;
        NewService.StockQuantity = 1;
        NewService.IconClass = "fas fa-wrench";
    }

    private async Task HandleIconUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                // Create unique filename
                var fileName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";

                // Define folder path: wwwroot/Image/icons
                var folderPath = Path.Combine(Environment.WebRootPath, "Image", "icons");

                // Ensure directory exists
                if (!Directory.Exists(folderPath))
                {
                    Directory.CreateDirectory(folderPath);
                }

                var fullPath = Path.Combine(folderPath, fileName);

                // Save file (Limit size to 2MB)
                await using var stream = new FileStream(fullPath, FileMode.Create);
                await file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024).CopyToAsync(stream);

                // Update Model
                NewService.ImageURL1 = $"/Image/icons/{fileName}";
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading file: {ex.Message}");
            }
        }
    }

    private async Task HandleAddService()
    {
        using var context = DbFactory.CreateDbContext();

        NewService.ProductCategory = "Software";
        NewService.Type = ProductType.Service;

        context.Products.Add(NewService);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/admin/services");
    }
}