@page "/admin/repairs"
@using MaisonTelecom.Models
@using MaisonTelecom.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavManager
@layout MaisonTelecom.Components.Layout.AdminLayout
@rendermode InteractiveServer

<div class="admin-page-container">
    <div class="admin-header">
        <h1>Repair Management</h1>
        <a href="/admin/repairs/add" class="add-btn">+ New Ticket</a>
    </div>

    <div class="repair-stats">
        <div class="stat-card">
            <h3>In Queue</h3>
            <p>@Repairs.Count(r => r.Status == "Checked In")</p>
        </div>
        <div class="stat-card">
            <h3>On Bench</h3>
            <p>@Repairs.Count(r => r.Status == "In Progress")</p>
        </div>
        <div class="stat-card green">
            <h3>Ready</h3>
            <p>@Repairs.Count(r => r.Status == "Ready")</p>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Ticket #</th>
                    <th>Customer</th>
                    <th>Device</th>
                    <th>Status</th>
                    <th>Date In</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ticket in Repairs.OrderByDescending(r => r.DateReceived))
                {
                    <tr>
                        <td><strong>@ticket.TicketNumber</strong></td>
                        <td>
                            @ticket.CustomerName<br />
                            <small>@ticket.CustomerPhone</small>
                        </td>
                        <td>@ticket.DeviceModel</td>
                        <td>
                            @* Updated Class Logic Here *@
                            <span class="status-badge @GetStatusClass(ticket.Status)">
                                @ticket.Status
                            </span>
                        </td>
                        <td>@ticket.DateReceived.ToShortDateString()</td>
                        <td>
                            <a href="/admin/repairs/edit/@ticket.Id" class="btn-edit">Manage</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .add-btn {
        background: #007bff;
        color: white;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

    .repair-stats {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 10px;
        flex: 1;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        text-align: center;
    }

        .stat-card h3 {
            font-size: 0.9rem;
            color: #777;
            margin-bottom: 5px;
        }

        .stat-card p {
            font-size: 1.5rem;
            font-weight: bold;
            margin: 0;
        }

        .stat-card.green p {
            color: #2ecc71;
        }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
    }

        .admin-table th, .admin-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #eee;
        }

    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
        white-space: nowrap; /* Prevents text wrapping */
        display: inline-block;
    }

        .status-badge.received {
            background: #eee;
            color: #555;
        }

        /* FIX: Renamed from .progress to .in-progress to avoid Bootstrap conflict */
        .status-badge.in-progress {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        .status-badge.ready {
            background: #d4edda;
            color: #155724;
        }

    .btn-edit {
        background: #17a2b8;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.9rem;
    }
</style>

@code {
    private List<RepairTicket> Repairs = new();

    protected override async Task OnInitializedAsync()
    {
        Repairs = await DbContext.RepairTickets.ToListAsync();
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Checked In" => "received",
            "In Progress" => "in-progress", // Changed this string
            "Ready" => "ready",
            _ => ""
        };
    }
}