@page "/admin/customers"
@layout MaisonTelecom.Components.Layout.AdminLayout

@using MaisonTelecom.Data
@using MaisonTelecom.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<div class="admin-page-container">
    <h1 class="admin-page-title">Customer</h1>
    <div class="admin-content-box">
        <div class="admin-content-header">
            <h2>Customers List</h2>
        </div>
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>S/N</th>
                        <th>Customer Name</th>
                        <th>Phone Number</th>
                        <th>Purchases</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pagedCustomers == null)
                    {
                        <tr><td colspan="5">Loading customers...</td></tr>
                    }
                    else
                    {
                        @foreach (var (customer, index) in pagedCustomers.Select((value, i) => (value, i)))
                        {
                            <tr>
                                @* S/N now calculates based on current page *@
                                <td>@((index + 1) + (currentPage - 1) * pageSize)</td>
                                <td>@customer.FirstName @customer.LastName</td>
                                <td>@customer.PhoneNumber</td>
                                <td>@customer.Orders.Count()</td>
                                <td><a href="/admin/customer/@customer.Id" class="view-button">View</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ---- UPDATED PAGINATION ---- *@
        <div class="admin-pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                int pageNum = i;
                <span class="@(currentPage == pageNum ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                    @GetCircledNumber(pageNum)
                </span>
            }

            @if (currentPage < totalPages)
            {
                <span @onclick="() => GoToPage(currentPage + 1)">Next →</span>
            }
        </div>
    </div>
</div>

@code {
    private List<Customer> pagedCustomers;
    private int currentPage = 1;
    private int pageSize = 20; // Set to 20 as requested
    private int totalCustomers;
    private int totalPages;

    protected override async Task OnInitializedAsync()
    {
        totalCustomers = await DbContext.Customers.CountAsync();
        totalPages = (int)Math.Ceiling(totalCustomers / (double)pageSize);
        await LoadPageData();
    }

    private async Task LoadPageData()
    {
        pagedCustomers = await DbContext.Customers
                                     .Include(c => c.Orders)
                                     .OrderBy(c => c.LastName)
                                     .Skip((currentPage - 1) * pageSize)
                                     .Take(pageSize)
                                     .ToListAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        await LoadPageData();
    }

    // Helper to match your design "①, ②, ③"
    private string GetCircledNumber(int num)
    {
        return num switch
        {
            1 => "①",
            2 => "②",
            3 => "③",
            4 => "④",
            5 => "⑤",
            6 => "⑥",
            7 => "⑦",
            8 => "⑧",
            9 => "⑨",
            10 => "⑩",
            _ => num.ToString() // Fallback for numbers > 10
        };
    }
}