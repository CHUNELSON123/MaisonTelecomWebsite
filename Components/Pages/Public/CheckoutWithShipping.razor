@page "/checkout-shipping"
@rendermode InteractiveServer
@using MaisonTelecom.Services
@using MaisonTelecom.Models
@using MaisonTelecom.ViewModels
@inject StateContainer State
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<div class="checkout-page">
    <div class="checkout-form">
        <EditForm Model="@checkoutModel" OnValidSubmit="OrderViaWhatsApp">
            <DataAnnotationsValidator />

            <div class="delivery-section">
                <h2>Delivery</h2>
                <div class="delivery-options">
                    <label class="radio-option" @onclick='() => NavigationManager.NavigateTo("/checkout-pickup")'>
                        <div>
                            <input type="radio" name="delivery" value="pickup" />
                            <span>Pickup in store</span>
                        </div>
                        <i class="fas fa-store"></i>
                    </label>
                    <label class="radio-option active">
                        <div>
                            <input type="radio" name="delivery" value="ship" checked />
                            <span>Ship</span>
                        </div>
                        <i class="fas fa-truck"></i>
                    </label>
                </div>
            </div>

            <div class="address-section">
                <h2>Info/Address</h2>
                <div class="form-row">
                    <InputText @bind-Value="checkoutModel.FirstName" placeholder="First Name" />
                    <InputText @bind-Value="checkoutModel.LastName" placeholder="Last Name" />
                </div>
                <InputText @bind-Value="checkoutModel.PhoneNumber" placeholder="Phone Number" />
                <InputText @bind-Value="checkoutModel.Address1" placeholder="Address 1 (Optional)" />
                <InputText @bind-Value="checkoutModel.Address2" placeholder="Address 2 (Optional)" />
                <InputText @bind-Value="checkoutModel.Address3" placeholder="Address 3 (Optional)" />
                <div class="form-row">
                    <InputText @bind-Value="checkoutModel.TownCity" placeholder="Town/City" />
                    <InputSelect @bind-Value="checkoutModel.Region">
                        <option value="">Region (Optional)</option>
                        <option value="Adamaoua">Adamaoua</option>
                        <option value="Centre">Centre</option>
                        <option value="East">East</option>
                        <option value="Far North">Far North</option>
                        <option value="Littoral">Littoral</option>
                        <option value="North">North</option>
                        <option value="North-West">North-West</option>
                        <option value="South">South</option>
                        <option value="South-West">South-West</option>
                        <option value="West">West</option>
                    </InputSelect>
                </div>
                <ValidationSummary />
            </div>

            <div class="payment-section">
                <h2>Complete Order</h2>
                <p>Click below to send your order details directly to us on WhatsApp. Delivery fees will be discussed.</p>
            </div>

            <button type="submit" class="pay-now-button action-button whatsapp-order-button">
                Order via WhatsApp
            </button>
        </EditForm>
    </div>

    <div class="order-summary">
        <h2>Order Summary</h2>
        @if (State.Cart.Any())
        {
            @foreach (var item in State.Cart)
            {
                <div class="summary-item">
                    <img src="@(string.IsNullOrEmpty(item.Product.ImageURL1) ? "/Image/iphone_thumb.jpg" : item.Product.ImageURL1)" alt="@item.Product.Name" />
                    <div>
                        <p>@item.Product.Name</p>
                        <p>FCFA @item.Product.Price.ToString("N0")</p>
                        <div class="quantity-controls">
                            <button type="button" @onclick="() => DecrementQuantity(item)">-</button>
                            <span>@item.Quantity</span>
                            <button type="button" @onclick="() => IncrementQuantity(item)">+</button>
                            <button type="button" class="remove-button" @onclick="() => RemoveItem(item)">Remove</button>
                        </div>
                    </div>
                </div>
            }
            <hr />
            <div class="summary-total">
                <p>Subtotal: @State.Cart.Sum(i => i.Quantity) items <span>FCFA @Subtotal.ToString("N0")</span></p>
                <p style="font-size: 0.9em; color: #666;">* Delivery fee depends on location</p>
            </div>
            <hr />
            <div class="summary-grand-total">
                <p>Total (Excl. Delivery) <span>FCFA @(Subtotal.ToString("N0"))</span></p>
            </div>
        }
        else
        {
            <p>Your cart is empty.</p>
        }
    </div>
</div>

@code {
    private CheckoutViewModel checkoutModel = new();
    private decimal Subtotal => State.Cart.Any() ? State.Cart.Sum(item => item.Product.Price * item.Quantity) : 0;

    // REMOVED: private const decimal ShippingCost = 6000;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await State.InitializeAsync();
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        State.OnStateChange += StateHasChanged;
    }

    private async Task OrderViaWhatsApp()
    {
        if (string.IsNullOrWhiteSpace(checkoutModel.FirstName) ||
            string.IsNullOrWhiteSpace(checkoutModel.LastName) ||
            string.IsNullOrWhiteSpace(checkoutModel.PhoneNumber) ||
            string.IsNullOrWhiteSpace(checkoutModel.TownCity))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please fill in your Name, Phone Number, and Town before ordering via WhatsApp.");
            return;
        }

        var orderSummary = "";
        var itemNumber = 1;
        foreach (var item in State.Cart)
        {
            orderSummary += $"{itemNumber}. {item.Product.Name} (Quantity: {item.Quantity}) - FCFA {item.Product.Price:N0}\n";
            itemNumber++;
        }

        var subtotal = Subtotal;
        // REMOVED: Shipping calculation

        orderSummary += $"\nSubtotal: FCFA {subtotal:N0}\n";
        // ADDED: Note about delivery
        orderSummary += "Delivery Fee: To be discussed based on location\n";
        orderSummary += $"Total (Excl. Delivery): FCFA {subtotal:N0}";

        var customerDetails = $"Name: {checkoutModel.FirstName} {checkoutModel.LastName}\n" +
                              $"Phone: {checkoutModel.PhoneNumber}\n";
        if (!string.IsNullOrWhiteSpace(checkoutModel.Address1)) customerDetails += $"Address 1: {checkoutModel.Address1}\n";
        if (!string.IsNullOrWhiteSpace(checkoutModel.Address2)) customerDetails += $"Address 2: {checkoutModel.Address2}\n";
        if (!string.IsNullOrWhiteSpace(checkoutModel.Address3)) customerDetails += $"Address 3: {checkoutModel.Address3}\n";
        customerDetails += $"Town/City: {checkoutModel.TownCity}\n";
        if (!string.IsNullOrWhiteSpace(checkoutModel.Region)) customerDetails += $"Region: {checkoutModel.Region}\n";

        var phoneNumber = "237671007313";
        var message = $"Hello Maison Telecom, I would like to place the following order for shipping:\n\n--- Customer Details ---\n{customerDetails}\n\n--- Order Summary ---\n{orderSummary}";
        var encodedMessage = Uri.EscapeDataString(message);
        var whatsappUrl = $"https://wa.me/{phoneNumber}?text={encodedMessage}";

        NavigationManager.NavigateTo(whatsappUrl, forceLoad: true);
    }

    private async Task IncrementQuantity(CartItem item)
    {
        await State.UpdateCartItemQuantity(item, item.Quantity + 1);
    }

    private async Task DecrementQuantity(CartItem item)
    {
        if (item.Quantity > 1)
        {
            await State.UpdateCartItemQuantity(item, item.Quantity - 1);
        }
    }

    private async Task RemoveItem(CartItem item)
    {
        await State.RemoveFromCart(item);
    }

    public void Dispose()
    {
        State.OnStateChange -= StateHasChanged;
    }
}