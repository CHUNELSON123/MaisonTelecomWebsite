@page "/delivery"
@rendermode InteractiveServer

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="mb-4">Delivery Information</h1>
            
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <i class="fas fa-truck fa-3x mb-3 text-primary"></i>
                    <h3>Shipping & Delivery</h3>
                    <p class="lead mt-3">
                        Delivery arrangements will be discussed directly with the client by the shop owner.
                    </p>
                    <p class="text-muted">
                        The final delivery cost depends on your specific location and the items ordered. 
                        Once you place your order, we will contact you to confirm the best delivery method for you.
                    </p>
                    
                    <a href="/shop" class="btn btn-primary mt-3">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Simple styling consistent with your site */
    .text-primary { color: #007bff !important; }
    .card { border: none; border-radius: 10px; }
</style>