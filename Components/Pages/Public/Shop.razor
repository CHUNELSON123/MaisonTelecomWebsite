@page "/shop"
@rendermode InteractiveServer
@using MaisonTelecom.Components.Shared
@using MaisonTelecom.Data
@using MaisonTelecom.Services
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext dbContext
@inject NavigationManager NavigationManager
@inject ProductService ProductService

<div class="shop-page">
    <div class="sub-header">
        <div class="filter-bar">
            <a href="/"><i class="fas fa-home"></i></a>

            @* REMOVED THE LOCAL SEARCH BAR HERE AS REQUESTED *@

            <div class="sort-container">
                <button class="filter-btn" @onclick="ToggleBrandMenu">
                    @(string.IsNullOrEmpty(selectedBrandFilter) ? "All Brands" : selectedBrandFilter)
                    <i class="fas fa-chevron-down" style="font-size: 0.8em; margin-left: 5px;"></i>
                </button>

                @if (showBrandMenu)
                {
                    <div class="sort-dropdown-menu">
                        <div class="sort-option" @onclick='() => SelectBrand(null)'>All Brands</div>
                        @if (BrandOptions != null)
                        {
                            @foreach (var brand in BrandOptions)
                            {
                                <div class="sort-option" @onclick='() => SelectBrand(brand)'>@brand</div>
                            }
                        }
                    </div>
                }
            </div>

            <div class="sort-container">
                <button class="filter-btn" @onclick="ToggleSortMenu">
                    @GetSortLabel(currentSortOption) <i class="fas fa-chevron-down" style="font-size: 0.8em; margin-left: 5px;"></i>
                </button>

                @if (showSortMenu)
                {
                    <div class="sort-dropdown-menu">
                        <div class="sort-option" @onclick='() => ApplySort("latest")'>Latest</div>
                        <div class="sort-option" @onclick='() => ApplySort("price_asc")'>Price: Low to High</div>
                        <div class="sort-option" @onclick='() => ApplySort("price_desc")'>Price: High to Low</div>
                    </div>
                }
            </div>
        </div>

        <h1>@(string.IsNullOrEmpty(Search) ? (string.IsNullOrEmpty(selectedBrandFilter) ? "All Products" : $"{selectedBrandFilter} Products") : $"Results for '{Search}'")</h1>

        <div class="category-filters">
            @* "All" button allows resetting category filter manually *@
            <button class="@(string.IsNullOrEmpty(selectedCategory) ? "active" : "")" @onclick='() => FilterByCategory(null)'>All</button>
            <button class="@(selectedCategory == "Phones" ? "active" : "")" @onclick='() => FilterByCategory("Phones")'>Phones</button>
            <button class="@(selectedCategory == "Laptops" ? "active" : "")" @onclick='() => FilterByCategory("Laptops")'>Laptops</button>
            <button class="@(selectedCategory == "Accessories" ? "active" : "")" @onclick='() => FilterByCategory("Accessories")'>Accessories</button>
        </div>
    </div>

    <div class="product-grid">
        @if (PagedProducts != null)
        {
            @if (PagedProducts.Count > 0)
            {
                @foreach (var product in PagedProducts)
                {
                    <ProductCard Product="product" />
                }
            }
            else
            {
                <div style="padding: 40px; width: 100%; text-align: center; color: #666;">
                    <i class="fas fa-search" style="font-size: 2em; margin-bottom: 15px; color: #ccc;"></i>
                    <p>No products found matching "@Search".</p>
                    <button class="filter-btn" style="margin-top:10px; display:inline-block;" @onclick="ClearAllFilters">Clear Filters</button>
                </div>
            }
        }
        else
        {
            <p>Loading products...</p>
        }
    </div>

    <div class="pagination">
        <button disabled="@(CurrentPage == 1)" @onclick="() => NavigateToPage(CurrentPage - 1)">&lt;</button>
        @for (int i = 1; i <= TotalPages; i++)
        {
            var pageNumber = i;
            <button class="@(CurrentPage == pageNumber ? "active" : "")" @onclick="() => NavigateToPage(pageNumber)">@pageNumber</button>
        }
        <button disabled="@(CurrentPage == TotalPages)" @onclick="() => NavigateToPage(CurrentPage + 1)">&gt;</button>
    </div>

    <div class="recently-viewed">
        <h2>Recently Viewed</h2>
        <div class="product-grid">
            @if (RecentlyViewedProducts != null)
            {
                @foreach (var product in RecentlyViewedProducts)
                {
                    <ProductCard Product="product" />
                }
            }
        </div>
    </div>
</div>

<style>
    /* Sort and Filter Styles */
    .sort-container {
        position: relative;
        display: inline-block;
        margin-left: 10px;
    }

    .sort-dropdown-menu {
        position: absolute;
        top: 110%;
        left: 0;
        background-color: white;
        min-width: 160px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        border-radius: 6px;
        border: 1px solid #eee;
        z-index: 1000;
        overflow: hidden;
    }

    .sort-option {
        padding: 10px 15px;
        cursor: pointer;
        font-size: 0.95em;
        color: #333;
        transition: background-color 0.2s;
    }

        .sort-option:hover {
            background-color: #f0f0f0;
            color: #000;
        }

    .category-filters {
        margin-top: 15px;
    }

        .category-filters button {
            margin-right: 10px;
        }

    .filter-btn {
        background: white;
        border: 1px solid #ddd;
        padding: 8px 15px;
        border-radius: 20px;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .filter-btn:hover {
            background-color: #f8f9fa;
            border-color: #ccc;
        }
</style>

@code {
    private List<MaisonTelecom.Models.Product> PagedProducts;
    private List<MaisonTelecom.Models.Product> RecentlyViewedProducts;

    public List<string> BrandOptions { get; set; } = new List<string>();

    private int CurrentPage = 1;
    private int PageSize = 18;
    private int TotalPages;

    private bool showSortMenu = false;
    private bool showBrandMenu = false;

    // Default to "Phones" only if no search is active
    private string selectedCategory = "Phones";
    private string selectedBrandFilter = null;
    private string currentSortOption = "latest";

    [SupplyParameterFromQuery]
    public string? Search { get; set; }

    protected override async Task OnInitializedAsync()
    {
        BrandOptions = await ProductService.GetAttributeValuesAsync("Brand");
        RecentlyViewedProducts = await dbContext.Products
            .Where(p => p.Type == MaisonTelecom.Models.ProductType.Physical)
            .OrderByDescending(p => p.Id)
            .Take(3)
            .ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // LOGIC: If a Search term exists (e.g. from the header), we must RESET the category
        // so that the search looks through EVERYTHING, not just "Phones".
        if (!string.IsNullOrEmpty(Search))
        {
            selectedCategory = null;
        }
        else if (string.IsNullOrEmpty(selectedCategory))
        {
            // If no search and no category, default back to Phones
            selectedCategory = "Phones";
        }

        await UpdateProductList();
    }

    private void ToggleBrandMenu()
    {
        showBrandMenu = !showBrandMenu;
        if (showBrandMenu) showSortMenu = false;
    }

    private async Task SelectBrand(string brand)
    {
        selectedBrandFilter = brand;
        showBrandMenu = false;
        CurrentPage = 1;
        await UpdateProductList();
    }

    private async Task UpdateProductList()
    {
        var query = dbContext.Products
            .Where(p => p.Type == MaisonTelecom.Models.ProductType.Physical)
            .AsQueryable();

        // 1. Search Logic (Moved to Top Priority)
        // This ensures "sam" matches "Samsung" using ToLower() for case-insensitivity
        if (!string.IsNullOrEmpty(Search))
        {
            var lowerSearch = Search.ToLower();
            query = query.Where(p =>
                p.Name.ToLower().Contains(lowerSearch) ||
                p.Brand.ToLower().Contains(lowerSearch) ||
                p.ProductCategory.ToLower().Contains(lowerSearch));
        }

        // 2. Category Filter (Only if not null)
        if (!string.IsNullOrEmpty(selectedCategory))
        {
            query = query.Where(p => p.ProductCategory == selectedCategory);
        }

        // 3. Brand Filter
        if (!string.IsNullOrEmpty(selectedBrandFilter))
        {
            query = query.Where(p => p.Brand == selectedBrandFilter);
        }

        // 4. Sorting
        switch (currentSortOption)
        {
            case "price_asc":
                query = query.OrderBy(p => p.Price);
                break;
            case "price_desc":
                query = query.OrderByDescending(p => p.Price);
                break;
            case "latest":
            default:
                query = query.OrderByDescending(p => p.Id);
                break;
        }

        var totalProductCount = await query.CountAsync();
        TotalPages = totalProductCount > 0 ? (int)Math.Ceiling(totalProductCount / (double)PageSize) : 1;

        PagedProducts = await query
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private void ToggleSortMenu()
    {
        showSortMenu = !showSortMenu;
        if (showSortMenu) showBrandMenu = false;
    }

    private async Task ApplySort(string sortOption)
    {
        currentSortOption = sortOption;
        showSortMenu = false;
        CurrentPage = 1;
        await UpdateProductList();
    }

    private string GetSortLabel(string option)
    {
        return option switch
        {
            "price_asc" => "Price: Low to High",
            "price_desc" => "Price: High to Low",
            _ => "Latest"
        };
    }

    private async Task NavigateToPage(int pageNumber)
    {
        CurrentPage = pageNumber;
        await UpdateProductList();
    }

    private async Task FilterByCategory(string category)
    {
        selectedCategory = category;
        // Do NOT clear Search here to allow searching INSIDE a category
        CurrentPage = 1;
        await UpdateProductList();
    }

    private async Task ClearAllFilters()
    {
        Search = null;
        selectedBrandFilter = null;
        selectedCategory = "Phones";
        await UpdateProductList();
    }
}