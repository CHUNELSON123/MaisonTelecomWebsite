@page "/product/{Id:int}"
@rendermode InteractiveServer
@using MaisonTelecom.Components.Shared
@using Microsoft.EntityFrameworkCore
@using MaisonTelecom.Data
@using MaisonTelecom.Services
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject StateContainer State
@inject NavigationManager NavigationManager
@implements IDisposable

<style>
    .spec-item {
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .spec-content {
        padding-left: 20px;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
    }

        .spec-content.show {
            max-height: 500px;
            transition: max-height 0.5s ease-in;
        }

        .spec-content ul {
            list-style-type: disc;
            padding-left: 20px;
            margin-top: 10px;
        }

    .old-price {
        text-decoration: line-through;
        color: #999;
        font-size: 1rem;
        margin-right: 10px;
    }

    .promo-price {
        color: #e74c3c;
        font-weight: bold;
        font-size: 1.5rem;
    }

    .highlights-grid.centered-grid {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .highlight-item {
        min-width: 120px;
        text-align: center;
    }

    /* --- LIGHTBOX STYLES --- */
    .lightbox-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        animation: fadeIn 0.3s;
    }

    .lightbox-content {
        position: relative;
        max-width: 85%;
        max-height: 90%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .lightbox-content img {
            max-width: 100%;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 4px;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }

    /* Lightbox Navigation Buttons - UPDATED FOR VISIBILITY */
    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        /* Changed to dark background so white arrows show on white images */
        background: rgba(0, 0, 0, 0.5);
        color: white;
        border: none;
        font-size: 2rem;
        padding: 1rem;
        cursor: pointer;
        z-index: 10001;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.3s;
    }

        .lightbox-nav:hover {
            background: rgba(0, 0, 0, 0.8); /* Darker on hover */
        }

        .lightbox-nav.prev {
            left: 20px;
        }

        .lightbox-nav.next {
            right: 20px;
        }

    .lightbox-close {
        position: absolute;
        top: 20px;
        right: 30px;
        background: none;
        border: none;
        color: white;
        font-size: 3rem;
        cursor: pointer;
        z-index: 10001;
        line-height: 1;
        text-shadow: 0 0 5px rgba(0,0,0,0.8);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .main-image {
        cursor: zoom-in;
    }

    /* --- MOBILE RESPONSIVE STYLES --- */
    @@media (max-width: 768px) {
        .lightbox-nav {
            width: 45px;
            height: 45px;
            font-size: 1.2rem;
            padding: 0;
            /* Dark background ensures visibility on white phone images */
            background: rgba(0, 0, 0, 0.6);
        }

            .lightbox-nav.prev {
                left: 10px;
            }

            .lightbox-nav.next {
                right: 10px;
            }

        .lightbox-close {
            top: 15px;
            right: 15px;
            font-size: 2.5rem;
        }
    }
</style>

<div class="product-page">
    @if (product != null)
    {
        <div class="main-content">
            <div class="image-gallery">
                <div class="thumbnails">
                    @foreach (var imageUrl in GetImageUrls())
                    {
                        <img src="@imageUrl" alt="@product.Name Thumbnail" @onclick="() => SetMainImage(imageUrl)" />
                    }
                </div>

                <div class="main-image" @onclick="OpenLightbox">
                    <img src="@mainImageUrl" alt="@product.Name" />
                </div>
            </div>

            <div class="product-info">
                <span class="brand">@product.Brand</span>
                <h1>@product.Name</h1>
                <span class="specs">@product.RAM RAM, @product.ROM ROM</span>

                <div class="price-section">
                    @if (product.PromoPrice > 0 && product.PromoPrice < product.Price)
                    {
                        <span class="old-price">FCFA @product.Price.ToString("N0")</span>
                        <span class="promo-price">FCFA @product.PromoPrice?.ToString("N0")</span>
                    }
                    else
                    {
                        <span class="price" style="font-size: 1.5rem; font-weight: bold;">FCFA @product.Price.ToString("N0")</span>
                    }
                </div>

                <span class="condition">State: New</span>

                <div class="quantity">
                    <label for="quantity">Quantity:</label>
                    <input type="number" id="quantity" value="1" min="1" />
                </div>
                <div class="actions">
                    <button class="add-to-card" @onclick="AddToCart">
                        Add to Card - FCFA @((product.PromoPrice > 0 && product.PromoPrice < product.Price ? product.PromoPrice : product.Price)?.ToString("N0"))
                    </button>
                    <button class="add-to-wishlist" @onclick="AddToWishlist"><i class="far fa-heart"></i> Add to Wishlist</button>
                    <button class="buy-now" @onclick="BuyNow">Buy Now</button>
                </div>
            </div>
        </div>

        @if (ShowHighlights)
        {
            <div class="product-highlights">
                <h2>Product Highlights</h2>
                <div class="highlights-grid centered-grid">
                    @if (HasSpec(product.Processor))
                    {
                        <div class="highlight-item"><i class="fas fa-microchip"></i><span>@product.Processor</span><small>Processor</small></div>
                    }
                    @if (HasSpec(product.RAM))
                    {
                        <div class="highlight-item"><i class="fas fa-memory"></i><span>@product.RAM</span><small>RAM</small></div>
                    }
                    @if (HasSpec(product.ROM))
                    {
                        <div class="highlight-item"><i class="fas fa-sd-card"></i><span>@product.ROM</span><small>Storage</small></div>
                    }
                    @if (HasSpec(product.Display))
                    {
                        <div class="highlight-item"><i class="fas fa-desktop"></i><span>@product.Display</span><small>Display</small></div>
                    }
                </div>
            </div>
        }

        <div class="tech-specs">
            <h2>Tech Specs</h2>
            <div class="spec-item" @onclick="() => ToggleSpec(0)"><span>Basic Details</span><i class="fas @(specVisibility[0] ? "fa-minus" : "fa-plus")"></i></div>
            <div class="spec-content @(specVisibility[0] ? "show" : "")"><ul>@foreach (var item in GetSpecList(product.BasicSpecs)) {
            <li>@item</li>
        }
</ul></div>

        <div class="spec-item" @onclick="() => ToggleSpec(1)"><span>Display Properties</span><i class="fas @(specVisibility[1] ? "fa-minus" : "fa-plus")"></i></div>
        <div class="spec-content @(specVisibility[1] ? "show" : "")"><ul>@foreach (var item in GetSpecList(product.DisplayProperties)) {
        <li>@item</li>
                }
</ul></div>

        <div class="spec-item" @onclick="() => ToggleSpec(2)"><span>Special Features</span><i class="fas @(specVisibility[2] ? "fa-minus" : "fa-plus")"></i></div>
        <div class="spec-content @(specVisibility[2] ? "show" : "")"><ul>@foreach (var item in GetSpecList(product.SpecialFeatures)) {
        <li>@item</li>
                }
</ul></div>
    </div>

    <div class="product-section">
        <h2>You May Also Like</h2>
        <div class="product-carousel">
            @if (relatedProducts != null)
            {
                @foreach (var relatedProduct in relatedProducts)
                {
                    <ProductCard Product="relatedProduct" />
                }
            }
        </div>
    </div>
        }
        else
    {
        <p>Loading product details...</p>
    }
</div>

@* --- LIGHTBOX OVERLAY --- *@
@if (isLightboxOpen && !string.IsNullOrEmpty(mainImageUrl))
{
    <div class="lightbox-overlay" @onclick="CloseLightbox">
        <button class="lightbox-nav prev" @onclick="PrevLightboxImage" @onclick:stopPropagation>
            <i class="fas fa-chevron-left"></i>
        </button>

        <div class="lightbox-content" @onclick:stopPropagation>
            <img src="@mainImageUrl" alt="Zoomed Product Image" />
        </div>

        <button class="lightbox-nav next" @onclick="NextLightboxImage" @onclick:stopPropagation>
            <i class="fas fa-chevron-right"></i>
        </button>

        <button class="lightbox-close" @onclick="CloseLightbox">&times;</button>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MaisonTelecom.Models.Product product;
    private List<MaisonTelecom.Models.Product> relatedProducts;
    private string mainImageUrl;
    private bool[] specVisibility = new bool[3];

    // --- LIGHTBOX VARIABLES ---
    private bool isLightboxOpen = false;
    private List<string> allImageUrls = new();
    private int currentImageIndex = 0;

    // Helpers
    private bool HasSpec(string? value) => !string.IsNullOrWhiteSpace(value);
    private bool ShowHighlights => product != null &&
        (HasSpec(product.Processor) || HasSpec(product.RAM) || HasSpec(product.ROM) || HasSpec(product.Display));

    protected override async Task OnParametersSetAsync()
    {
        using var dbContext = await DbFactory.CreateDbContextAsync();
        product = await dbContext.Products.FindAsync(Id);
        if (product != null)
        {
            // Populate Image List for Lightbox
            allImageUrls.Clear();
            if (!string.IsNullOrEmpty(product.ImageURL1)) allImageUrls.Add(product.ImageURL1);
            if (!string.IsNullOrEmpty(product.ImageURL2)) allImageUrls.Add(product.ImageURL2);
            if (!string.IsNullOrEmpty(product.ImageURL3)) allImageUrls.Add(product.ImageURL3);
            if (!string.IsNullOrEmpty(product.ImageURL4)) allImageUrls.Add(product.ImageURL4);
            if (!string.IsNullOrEmpty(product.ImageURL5)) allImageUrls.Add(product.ImageURL5);

            // Default Main Image
            if (allImageUrls.Any())
            {
                mainImageUrl = allImageUrls[0];
                currentImageIndex = 0;
            }
            else
            {
                mainImageUrl = "/Image/barca.jpeg"; // Fallback
            }

            relatedProducts = await dbContext.Products
                .Where(p => p.ProductCategory == product.ProductCategory && p.Id != product.Id)
                .Take(4)
                .ToListAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("scrollToTop");
            await State.InitializeAsync();
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        State.OnStateChange += StateHasChanged;
    }

    private IEnumerable<string> GetImageUrls() => allImageUrls;

    private void SetMainImage(string imageUrl)
    {
        mainImageUrl = imageUrl;
        // Update index for lightbox logic
        var index = allImageUrls.IndexOf(imageUrl);
        if (index >= 0) currentImageIndex = index;
    }

    // --- LIGHTBOX METHODS ---
    private void OpenLightbox() => isLightboxOpen = true;
    private void CloseLightbox() => isLightboxOpen = false;

    private void NextLightboxImage()
    {
        if (allImageUrls.Count > 0)
        {
            currentImageIndex = (currentImageIndex + 1) % allImageUrls.Count;
            mainImageUrl = allImageUrls[currentImageIndex];
        }
    }

    private void PrevLightboxImage()
    {
        if (allImageUrls.Count > 0)
        {
            currentImageIndex = (currentImageIndex - 1 + allImageUrls.Count) % allImageUrls.Count;
            mainImageUrl = allImageUrls[currentImageIndex];
        }
    }

    private void ToggleSpec(int index) => specVisibility[index] = !specVisibility[index];

    private string[] GetSpecList(string specs)
    {
        if (string.IsNullOrWhiteSpace(specs)) return Array.Empty<string>();
        return specs.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                      .Select(s => s.Trim())
                      .ToArray();
    }

    private async Task AddToCart()
    {
        if (product != null) await State.AddToCart(product);
    }

    private async Task AddToWishlist()
    {
        if (product != null) await State.AddToWishlist(product);
    }

    private async Task BuyNow()
    {
        await AddToCart();
        NavigationManager.NavigateTo("/checkout-shipping");
    }

    public void Dispose() => State.OnStateChange -= StateHasChanged;
}