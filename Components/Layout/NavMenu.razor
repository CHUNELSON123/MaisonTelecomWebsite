@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MaisonTelecom</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @* --- Public Links (Visible to Everyone) --- *@
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shop">
                <span class="bi bi-phone" aria-hidden="true"></span> Shop
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="services">
                <span class="bi bi-tools" aria-hidden="true"></span> Services & Repair
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="check-status">
                <span class="bi bi-clipboard-check" aria-hidden="true"></span> Check Status
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cart">
                <span class="bi bi-cart-fill" aria-hidden="true"></span> Cart
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="contact-us">
                <span class="bi bi-envelope-fill" aria-hidden="true"></span> Contact Us
            </NavLink>
        </div>

        @* --- ADMIN LINK ONLY --- *@
        @* Visible ONLY if logged in. Guests see nothing here. *@
        <AuthorizeView>
            <Authorized>
                <div style="border-top: 1px solid rgba(255,255,255,0.2); margin: 10px 16px;"></div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="admin/dashboard" style="color: #ffc107 !important; font-weight: bold;">
                        <span class="bi bi-speedometer2" aria-hidden="true"></span> Admin Panel
                    </NavLink>
                </div>
            </Authorized>
            @* <NotAuthorized> is empty, so guests see nothing extra *@
        </AuthorizeView>

    </nav>
</div>